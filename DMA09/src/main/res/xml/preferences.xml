<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/pref_cat_profile">
        <EditTextPreference
            app:key="user_name"
            app:title="@string/pref_user_name"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_display">
        <SwitchPreferenceCompat
            app:key="dark_mode"
            app:title="@string/pref_dark_mode"
            app:summary="@string/pref_dark_mode_summary"
            app:defaultValue="false" />

        <ListPreference
            app:key="sort_order"
            app:title="@string/pref_sort"
            app:entries="@array/sort_labels"
            app:entryValues="@array/sort_values"
            app:defaultValue="date"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>
</PreferenceScreen>
