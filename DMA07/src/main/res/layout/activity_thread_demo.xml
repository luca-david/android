<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">

    <TextView android:id="@+id/tvProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Idle" android:textSize="18sp" />
    <Button android:id="@+id/btnStart" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Start heavy work" />

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DDD" android:layout_marginVertical="24dp" />

    <TextView android:id="@+id/tvTaps" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Taps: 0" android:textSize="18sp" />
    <Button android:id="@+id/btnTap" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tap me (UI stays responsive)" />
</LinearLayout>
