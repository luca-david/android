<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_horizontal" android:padding="16dp">

    <ImageView android:id="@+id/ivPoster" android:layout_width="240dp" android:layout_height="360dp" android:background="#11000000" android:scaleType="centerCrop" android:contentDescription="Loaded image" />
    <Button android:id="@+id/btnLoad" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Load image from URL" />
</LinearLayout>
